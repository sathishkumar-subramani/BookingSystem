# Copy to .env for local runs. Never commit the real .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=arangam
# 32+ random characters in production (Render generates one for you)
JWT_SECRET=
# Comma-separated; empty = allow any origin (bearer tokens, no cookies). Wildcards like https://*.vercel.app work.
CLIENT_ORIGINS=
# Fill an empty database with demo halls, owners and bookings on start
SEED_DEMO_DATA=true
# Booking rules
HOLD_MINUTES=10
PLATFORM_FEE_PERCENT=5
MAX_ADVANCE_DAYS=540
# Payments: mock now; razorpay later (needs the two keys below)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change-me-too
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# Locations: static (TN district table) now; google later
LOCATION_PROVIDER=static
# GOOGLE_MAPS_API_KEY=
# PORT=5090
